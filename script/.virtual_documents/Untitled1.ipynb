import numpy as np
import matplotlib.pyplot as plt

def create_phase_validation_figure(
    a_scan_cw, compensated_phase_cw, uncompensated_phase_cw,
    a_scan_chirp, compensated_phase_chirp, uncompensated_phase_chirp,
    start_freq_hz, step_freq_hz, output_filename="phase_validation.png"):
    """
    Generates and saves a publication-quality figure to validate phase compensation.

    The figure consists of a 2x2 grid:
    (a) Uncompensated vs. Compensated Phase (CW)
    (b) Uncompensated vs. Compensated Phase (Chirp)
    (c) A-scan Profile (CW)
    (d) A-scan Profile (Chirp)

    Args:
        a_scan_cw (np.ndarray): A-scan profile for the CW experiment.
        compensated_phase_cw (np.ndarray): Compensated phase vs. frequency for CW.
        uncompensated_phase_cw (np.ndarray): Uncompensated phase vs. frequency for CW.
        a_scan_chirp (np.ndarray): A-scan profile for the Chirp experiment.
        compensated_phase_chirp (np.ndarray): Compensated phase vs. frequency for Chirp.
        uncompensated_phase_chirp (np.ndarray): Uncompensated phase vs. frequency for Chirp.
        start_freq_hz (float): The starting frequency of the SFCW sweep.
        step_freq_hz (float): The frequency step size of the SFCW sweep.
        output_filename (str): The filename to save the figure as.
    """
    # --- 1. Configure Matplotlib for Publication Quality ---
    plt.rcParams.update({
        'font.size': 10,
        'axes.labelsize': 10,
        'axes.titlesize': 12,
        'xtick.labelsize': 8,
        'ytick.labelsize': 8,
        'legend.fontsize': 8,
        'figure.dpi': 300,
        'savefig.dpi': 300,
        'font.family': 'serif',
        'font.serif': ['Times New Roman'],
    })

    # --- 2. Prepare Data for Plotting ---
    num_steps = len(compensated_phase_cw)
    frequency_axis = np.linspace(start_freq_hz, start_freq_hz + (num_steps - 1) * step_freq_hz, num_steps) / 1e9  # in GHz

    # Prepare A-scans in dB, normalized to 0 dB at the peak
    ascan_db_cw = 20 * np.log10(np.abs(a_scan_cw) / np.max(np.abs(a_scan_cw)) + 1e-9)
    ascan_db_chirp = 20 * np.log10(np.abs(a_scan_chirp) / np.max(np.abs(a_scan_chirp)) + 1e-9)
    range_bin_axis = np.arange(len(a_scan_cw))


    # --- 3. Create the 2x2 Figure ---
    fig, axs = plt.subplots(2, 2, figsize=(7, 5)) # 7 inches is suitable for IEEE double column width

    # --- (a) Phase Plot for CW ---
    axs[0, 0].plot(frequency_axis, uncompensated_phase_cw, '.', markersize=2, alpha=0.6, label='Uncompensated')
    axs[0, 0].plot(frequency_axis, np.unwrap(compensated_phase_cw), '-', linewidth=2, label='Compensated')
    axs[0, 0].set_title('(a) Phase vs. Frequency (CW)')
    axs[0, 0].set_xlabel('Frequency (GHz)')
    axs[0, 0].set_ylabel('Phase (radians)')
    axs[0, 0].grid(True, linestyle=':')
    axs[0, 0].legend()
    axs[0, 0].set_ylim(-np.pi * 1.2, np.pi * 1.2) # Set y-limits for uncompensated phase visibility

    # --- (b) Phase Plot for Chirp ---
    axs[0, 1].plot(frequency_axis, uncompensated_phase_chirp, '.', markersize=2, alpha=0.6, label='Uncompensated')
    axs[0, 1].plot(frequency_axis, np.unwrap(compensated_phase_chirp), '-', linewidth=2, label='Compensated')
    axs[0, 1].set_title('(b) Phase vs. Frequency (Chirp)')
    axs[0, 1].set_xlabel('Frequency (GHz)')
    axs[0, 1].set_ylabel('Phase (radians)')
    axs[0, 1].grid(True, linestyle=':')
    axs[0, 1].legend()
    axs[0, 1].set_ylim(-np.pi * 1.2, np.pi * 1.2)


    # --- (c) A-Scan Plot for CW ---
    axs[1, 0].plot(range_bin_axis, ascan_db_cw)
    axs[1, 0].set_title('(c) Range Profile (CW)')
    axs[1, 0].set_xlabel('Range Bin')
    axs[1, 0].set_ylabel('Magnitude (dB)')
    axs[1, 0].grid(True, linestyle=':')
    axs[1, 0].set_ylim(-60, 5)

    # --- (d) A-Scan Plot for Chirp ---
    axs[1, 1].plot(range_bin_axis, ascan_db_chirp)
    axs[1, 1].set_title('(d) Range Profile (Chirp)')
    axs[1, 1].set_xlabel('Range Bin')
    axs[1, 1].set_ylabel('Magnitude (dB)')
    axs[1, 1].grid(True, linestyle=':')
    axs[1, 1].set_ylim(-60, 5)

    # --- 4. Finalize and Save Figure ---
    plt.tight_layout()
    plt.savefig(output_filename, bbox_inches='tight')
    print(f"Figure saved as '{output_filename}'")
    plt.show()


if __name__ == '__main__':
    # --- This section simulates data so the script is runnable ---
    # In your actual project, you would load your data from files here.

    NUM_STEPS = 128
    START_FREQ = 1e9  # 1 GHz
    STEP_FREQ = 10e6  # 10 MHz
    TARGET_DELAY_SAMPLES = 20 # Simulates a target at range bin 20

    # Simulate random phase error
    random_phase_error = np.random.uniform(-np.pi, np.pi, NUM_STEPS)

    # Simulate compensated phase (linear ramp + noise)
    phase_slope = -2 * np.pi * TARGET_DELAY_SAMPLES / NUM_STEPS
    comp_phase_ideal = (np.arange(NUM_STEPS) * phase_slope) % (2 * np.pi)
    comp_phase_noisy = comp_phase_ideal + np.random.normal(0, 0.05, NUM_STEPS)

    # Simulate uncompensated phase (linear ramp + noise + random error)
    uncomp_phase = comp_phase_ideal + np.random.normal(0, 0.05, NUM_STEPS) + random_phase_error

    # Simulate A-scan profiles (from the compensated phase)
    freq_response_cw = np.exp(1j * comp_phase_noisy)
    ascan_cw = np.fft.ifftshift(np.fft.ifft(freq_response_cw))
    
    # Chirp will have better SNR in reality, simulate with less noise
    comp_phase_noisy_chirp = comp_phase_ideal + np.random.normal(0, 0.02, NUM_STEPS)
    uncomp_phase_chirp = comp_phase_noisy_chirp + random_phase_error
    freq_response_chirp = np.exp(1j * comp_phase_noisy_chirp)
    ascan_chirp = np.fft.ifftshift(np.fft.ifft(freq_response_chirp))


    # --- Call the function with the simulated data ---
    create_phase_validation_figure(
        a_scan_cw=ascan_cw,
        compensated_phase_cw=comp_phase_noisy,
        uncompensated_phase_cw=uncomp_phase,
        a_scan_chirp=ascan_chirp,
        compensated_phase_chirp=comp_phase_noisy_chirp,
        uncompensated_phase_chirp=uncomp_phase_chirp,
        start_freq_hz=START_FREQ,
        step_freq_hz=STEP_FREQ,
        output_filename="phase_validation.png"
    )

